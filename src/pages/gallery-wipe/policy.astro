---
const title = 'Gallery Wipe — Privacy Policy'
const updated = 'November 24, 2026'

const sections = [
	{
		heading: 'The short version',
		body: [
			'Gallery Wipe does not collect, transmit or sell any personal data. The app has no accounts, no analytics, no advertising and no servers. Everything it does happens on your device.',
		],
	},
	{
		heading: 'Your photos and videos',
		body: [
			'Gallery Wipe asks for access to your photo library so it can show you the photos and videos on this device and delete the ones you choose. Your media is read on the device only. Nothing is uploaded, copied to a server, or shared with us or anyone else.',
			'When you swipe or select items, Gallery Wipe only records a decision (keep, delete later, or skip) in a local database. No images leave your device.',
			'Deleting is always confirmed by you and by your operating system before anything is removed. On iOS, deleted items move to Recently Deleted in Photos, where you can recover them for 30 days. On Android, they are removed from the device.',
		],
	},
	{
		heading: 'What is stored on your device',
		body: [
			'A small local database keeps the decisions you have made, your filter settings and your preferences. It stays in the app’s private storage on your device and is removed when you uninstall the app. We have no way to read it.',
		],
	},
	{
		heading: 'Permissions we ask for',
		body: [
			'Photo library access: to browse, review and delete the photos and videos you choose. On Android this includes read access to images and videos, and the permission needed to request deletion of the items you select.',
		],
	},
	{
		heading: 'Third parties',
		body: [
			'Gallery Wipe does not include analytics SDKs, advertising networks, crash reporting services or any other third-party code that collects data. There are no in-app purchases and no subscriptions.',
		],
	},
	{
		heading: 'Children',
		body: [
			'Gallery Wipe is not directed at children and does not knowingly collect any information from anyone, including children.',
		],
	},
	{
		heading: 'Changes to this policy',
		body: [
			'If the app ever starts collecting data, this policy will be updated before that version is released, and the change will be described here.',
		],
	},
	{
		heading: 'Contact',
		body: [
			'Questions about this policy or about privacy in Gallery Wipe: mail@prastavna.com.',
		],
	},
]
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/prastavna.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Gallery Wipe does not collect any personal data. Photos are reviewed and deleted on your device only." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<style>
			body {
				font-family: 'Funnel Display', system-ui, sans-serif;
				background: #f8fafc;
			}
		</style>
	</head>
	<body class="min-h-screen text-slate-800">
		<header class="p-6 lg:p-8">
			<div class="max-w-3xl mx-auto flex items-center justify-between">
				<a href="/" class="flex items-center space-x-3">
					<img src="/prastavna.png" alt="Prastavna Logo" class="w-10 h-10 object-contain" />
					<span class="text-xl font-bold text-blue-500">Prastavna</span>
				</a>
				<a href="/#products" class="text-sm text-slate-600 hover:text-slate-900 transition-colors">All products</a>
			</div>
		</header>

		<main class="px-6 lg:px-8 pb-20">
			<article class="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-200 p-8 lg:p-12">
				<div class="flex items-center gap-4 mb-8">
					<img src="/gallery-wipe-logo.svg" alt="Gallery Wipe" class="w-12 h-12 object-contain" />
					<div>
						<h1 class="text-3xl font-bold text-slate-900">Privacy Policy</h1>
						<p class="text-slate-500">Gallery Wipe for iOS and Android · Updated {updated}</p>
					</div>
				</div>

				<div class="space-y-8">
					{
						sections.map((section) => (
							<section>
								<h2 class="text-lg font-semibold text-slate-900 mb-2">{section.heading}</h2>
								{section.body.map((paragraph) => (
									<p class="text-slate-600 leading-relaxed mb-2">{paragraph}</p>
								))}
							</section>
						))
					}
				</div>

				<p class="mt-10 pt-6 border-t border-slate-200 text-sm text-slate-500">
					Gallery Wipe is made by Prastavna. See also the <a href="/" class="text-blue-600 hover:underline">Prastavna website</a>.
				</p>
			</article>
		</main>
	</body>
</html>
