---
import '../../styles/global.css'

const title = 'Gallery Wipe — Privacy Policy'
const updated = 'November 24, 2026'
const updatedISO = '2026-11-24'
const currentYear = new Date().getFullYear()

const summary =
	'Gallery Wipe does not collect, transmit or sell any personal data. The app has no accounts, no analytics, no advertising and no servers. Everything it does happens on your device.'

const sections = [
	{
		id: 'your-photos',
		heading: 'Your photos and videos',
		body: [
			'Gallery Wipe asks for access to your photo library so it can show you the photos and videos on this device and delete the ones you choose. Your media is read on the device only. Nothing is uploaded, copied to a server, or shared with us or anyone else.',
			'When you swipe or select items, Gallery Wipe only records a decision (keep, delete later, or skip) in a local database. No images leave your device.',
			'Deleting is always confirmed by you and by your operating system before anything is removed. On iOS, deleted items move to Recently Deleted in Photos, where you can recover them for 30 days. On Android, they are removed from the device.',
		],
	},
	{
		id: 'what-is-stored',
		heading: 'What is stored on your device',
		body: [
			'A small local database keeps the decisions you have made, your filter settings and your preferences. It stays in the app’s private storage on your device and is removed when you uninstall the app. We have no way to read it.',
		],
	},
	{
		id: 'permissions',
		heading: 'Permissions we ask for',
		body: [
			'Photo library access: to browse, review and delete the photos and videos you choose.',
			'On Android this includes read access to images and videos, and the permission needed to request deletion of the items you select.',
		],
	},
	{
		id: 'third-parties',
		heading: 'Third parties',
		body: [
			'Gallery Wipe does not include analytics SDKs, advertising networks, crash reporting services or any other third-party code that collects data. There are no in-app purchases and no subscriptions.',
		],
	},
	{
		id: 'children',
		heading: 'Children',
		body: [
			'Gallery Wipe is not directed at children and does not knowingly collect any information from anyone, including children.',
		],
	},
	{
		id: 'changes',
		heading: 'Changes to this policy',
		body: [
			'If the app ever starts collecting data, this policy will be updated before that version is released, and the change will be described here.',
		],
	},
	{
		id: 'contact',
		heading: 'Contact',
		body: ['Questions about this policy or about privacy in Gallery Wipe?'],
		contact: true,
	},
]

const toc = [
	{ id: 'summary', heading: 'The short version' },
	...sections.map(({ id, heading }) => ({ id, heading })),
]

const words = [summary, ...sections.flatMap((section) => section.body)]
	.join(' ')
	.trim()
	.split(/\s+/).length
const readingTime = Math.max(1, Math.ceil(words / 220))
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/prastavna.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta
			name="description"
			content="Gallery Wipe does not collect any personal data. Photos are reviewed and deleted on your device only."
		/>
		<meta name="theme-color" content="#f8fafc" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta
			property="og:description"
			content="What Gallery Wipe does with your photos, your device and your data."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300;400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<style>
			body {
				font-family: 'Funnel Display', system-ui, sans-serif;
				background: #f8fafc;
			}

			@media (prefers-reduced-motion: no-preference) {
				html {
					scroll-behavior: smooth;
				}
			}

			::selection {
				background: #bfdbfe;
				color: #1e3a8a;
			}

			@media print {
				header,
				footer,
				aside,
				details,
				.no-print {
					display: none !important;
				}

				body {
					background: #fff;
				}

				main {
					padding: 1.5rem 0 0 !important;
				}

				article {
					border: 0 !important;
					box-shadow: none !important;
					padding: 0 !important;
				}

				section {
					break-inside: avoid;
				}
			}
		</style>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-slate-900 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
		>
			Skip to content
		</a>

		<div class="relative flex min-h-screen flex-col">
			<div
				aria-hidden="true"
				class="no-print pointer-events-none absolute inset-x-0 top-0 -z-0 h-[26rem] bg-gradient-to-b from-blue-100/60 via-blue-50/30 to-transparent"
			>
			</div>

			<header
				class="sticky top-0 z-40 border-b border-slate-200/70 bg-slate-50/80 backdrop-blur-md"
			>
				<div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-6 lg:px-8">
					<a
						href="/"
						aria-label="Prastavna home"
						class="group flex items-center gap-3 rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
					>
						<img
							src="/prastavna.png"
							alt=""
							width="36"
							height="36"
							class="h-9 w-9 object-contain"
						/>
						<span class="text-lg font-bold tracking-tight text-blue-500">Prastavna</span>
					</a>

					<a
						href="/#products"
						class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm transition-colors hover:border-slate-300 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
					>
						<svg
							aria-hidden="true"
							class="h-4 w-4"
							fill="none"
							stroke="currentColor"
							stroke-width="1.8"
							viewBox="0 0 24 24"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
						</svg>
						<span class="sm:hidden">Products</span>
						<span class="hidden sm:inline">All products</span>
					</a>
				</div>
			</header>

			<main
				id="main"
				tabindex="-1"
				class="relative z-10 flex-1 px-4 pt-10 pb-16 outline-none sm:px-6 lg:px-8 lg:pt-14"
			>
				<div class="mx-auto max-w-5xl">
					<div class="max-w-[46rem]">
						<div class="flex items-center gap-4 sm:gap-5">
							<img
								src="/gallery-wipe-logo.svg"
								alt=""
								width="64"
								height="64"
								class="h-14 w-14 shrink-0 drop-shadow-sm sm:h-16 sm:w-16"
							/>
							<div>
								<p class="text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
									Gallery Wipe<span class="hidden sm:inline"> · iOS &amp; Android</span>
								</p>
								<h1
									class="mt-1.5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"
								>
									Privacy Policy
								</h1>
							</div>
						</div>

						<p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
							What Gallery Wipe does with your photos, your device and your data — in plain
							language.
						</p>

						<div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1.5">
							<span
								class="inline-flex items-center gap-1.5 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-800"
							>
								<svg
									aria-hidden="true"
									class="h-3.5 w-3.5"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M9 12.75L11.25 15 15 9.75M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"
									></path>
								</svg>
								No data collected
							</span>
							<span class="text-xs font-medium text-slate-500">
								Updated <time datetime={updatedISO}>{updated}</time>
								<span class="mx-1.5 text-slate-300" aria-hidden="true">·</span>
								{readingTime} min read
							</span>
						</div>
					</div>

					<details
						class="group mt-8 rounded-2xl border border-slate-200 bg-white/80 shadow-sm lg:hidden"
					>
						<summary
							class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-semibold text-slate-900 [&::-webkit-details-marker]:hidden"
						>
							On this page
							<svg
								aria-hidden="true"
								class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								viewBox="0 0 24 24"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
								></path>
							</svg>
						</summary>
						<nav aria-label="On this page" class="border-t border-slate-100 p-2">
							{
								toc.map((item, index) => (
									<a
										href={`#${item.id}`}
										class="flex items-baseline gap-3 rounded-lg px-3 py-2 text-sm text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900"
									>
										<span
											aria-hidden="true"
											class="text-xs font-medium text-slate-400 tabular-nums"
										>
											{String(index + 1).padStart(2, '0')}
										</span>
										{item.heading}
									</a>
								))
							}
						</nav>
					</details>

					<div class="mt-8 grid gap-12 lg:mt-12 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start">
						<article
							class="rounded-3xl border border-slate-200/80 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_20px_50px_-24px_rgba(15,23,42,0.18)] sm:p-8 lg:p-12"
						>
							<section id="summary" class="scroll-mt-28">
								<div
									class="rounded-2xl border border-teal-200/80 bg-gradient-to-br from-teal-50 to-teal-50/40 p-4 sm:p-6"
								>
									<div class="flex items-center gap-3">
										<div
											class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-teal-200/70"
										>
											<svg
												aria-hidden="true"
												class="h-[18px] w-[18px] text-teal-600"
												fill="none"
												stroke="currentColor"
												stroke-width="1.8"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													d="M12 3l7 3v5.25c0 4.2-2.9 7.9-7 9.75-4.1-1.85-7-5.55-7-9.75V6l7-3z"
												></path>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													d="M9 12.2l2.1 2.1 4-4.2"
												></path>
											</svg>
										</div>
										<h2 class="text-base font-semibold text-teal-950">The short version</h2>
									</div>
									<p class="mt-3 text-[15px] leading-7 text-teal-900/80">{summary}</p>
								</div>
							</section>

							<div class="mt-10 space-y-10">
								{
									sections.map((section) => (
										<section id={section.id} class="scroll-mt-28">
											<h2
												class="group text-xl font-semibold tracking-tight text-slate-900"
											>
												<a
													href={`#${section.id}`}
													class="rounded-sm transition-colors hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-500"
												>
													{section.heading}
													<span
														aria-hidden="true"
														class="ml-1.5 font-normal text-slate-300 opacity-0 transition-opacity group-hover:opacity-100"
													>
														#
													</span>
												</a>
											</h2>

											<div class="mt-3 space-y-4">
												{section.body.map((paragraph) => (
													<p class="text-base leading-7 text-slate-600">{paragraph}</p>
												))}
											</div>

											{section.contact && (
												<div class="mt-5 flex flex-wrap items-center gap-3">
													<a
														href="mailto:hello@prastavna.com"
														class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
													>
														<svg
															aria-hidden="true"
															class="h-4 w-4"
															fill="none"
															stroke="currentColor"
															stroke-width="1.8"
															viewBox="0 0 24 24"
														>
															<path
																stroke-linecap="round"
																stroke-linejoin="round"
																d="M3.75 6.75h16.5v10.5H3.75z"
															></path>
															<path
																stroke-linecap="round"
																stroke-linejoin="round"
																d="M4 7l8 6 8-6"
															></path>
														</svg>
														hello@prastavna.com
													</a>
													<a
														href="https://github.com/Prastavna/gallery-wipe"
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition-colors hover:border-slate-300 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
													>
														View on GitHub
													</a>
												</div>
											)}
										</section>
									))
								}
							</div>

							<div
								class="mt-10 flex flex-col gap-3 border-t border-slate-100 pt-6 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"
							>
								<p>
									Gallery Wipe is made by <a
										href="/"
										class="font-medium text-slate-700 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-blue-700 hover:decoration-blue-300"
										>Prastavna</a
									>.
								</p>
								<a
									href="#main"
									class="inline-flex items-center gap-1.5 self-start text-slate-500 transition-colors hover:text-slate-900 sm:self-auto"
								>
									Back to top
									<svg
										aria-hidden="true"
										class="h-3.5 w-3.5"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										viewBox="0 0 24 24"
									>
										<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"
										></path>
									</svg>
								</a>
							</div>
						</article>

						<aside class="hidden lg:block">
							<div class="sticky top-24">
								<p class="text-xs font-semibold tracking-[0.14em] text-slate-400 uppercase">
									On this page
								</p>
								<nav aria-label="On this page" class="mt-4 border-l border-slate-200">
									{
										toc.map((item, index) => (
											<a
												href={`#${item.id}`}
												class="group -ml-px flex items-baseline gap-3 border-l-2 border-transparent py-1.5 pl-4 text-sm text-slate-500 transition-colors hover:border-blue-400 hover:text-slate-900"
											>
												<span
													aria-hidden="true"
													class="text-[11px] font-medium text-slate-300 tabular-nums"
												>
													{String(index + 1).padStart(2, '0')}
												</span>
												{item.heading}
											</a>
										))
									}
								</nav>

								<div class="mt-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
									<div class="flex items-center gap-2">
										<svg
											aria-hidden="true"
											class="h-4 w-4 text-teal-600"
											fill="none"
											stroke="currentColor"
											stroke-width="1.8"
											viewBox="0 0 24 24"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M12 3l7 3v5.25c0 4.2-2.9 7.9-7 9.75-4.1-1.85-7-5.55-7-9.75V6l7-3z"
											></path>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M9 12.2l2.1 2.1 4-4.2"
											></path>
										</svg>
										<p class="text-xs font-semibold text-slate-700">Privacy first</p>
									</div>
									<p class="mt-2 text-xs leading-relaxed text-slate-500">
										Your media stays on your device. Nothing is uploaded or shared.
									</p>
								</div>
							</div>
						</aside>
					</div>
				</div>
			</main>

			<footer class="border-t border-slate-200 bg-white/60">
				<div
					class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row lg:px-8"
				>
					<div class="flex items-center gap-3">
						<img
							src="/prastavna.png"
							alt=""
							width="28"
							height="28"
							class="h-7 w-7 object-contain"
						/>
						<span class="text-sm text-slate-500">
							© {currentYear} Prastavna. All rights reserved.
						</span>
					</div>

					<nav aria-label="Footer" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
						<a href="/" class="text-slate-500 transition-colors hover:text-slate-900">Home</a>
						<a href="/#products" class="text-slate-500 transition-colors hover:text-slate-900">
							Products
						</a>
						<a
							href="https://github.com/Prastavna/gallery-wipe"
							target="_blank"
							rel="noopener noreferrer"
							class="text-slate-500 transition-colors hover:text-slate-900"
						>
							GitHub
						</a>
						<a
							href="mailto:hello@prastavna.com"
							class="text-slate-500 transition-colors hover:text-slate-900"
						>
							Email
						</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
